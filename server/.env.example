PORT=5001
MONGO_URI=mongodb://localhost:27017/nirvana-cms
JWT_SECRET=your-strong-random-secret-here
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed CORS origins, e.g.
# https://admin.example.com,https://example.com
# Leave unset for local dev (reflects the request's own origin, same as the
# previous wide-open default) — only set this in deployed environments.
# Required (the app refuses to start without it) when NODE_ENV=production.
CORS_ORIGIN=

# Used by `npm run init:super-admin` (scripts/ensureSuperAdmin.ts) to create
# the first SuperAdmin if one doesn't already exist — idempotent, safe to
# leave set and re-run.
INIT_SUPER_ADMIN_EMAIL=mustapha.hamze1@gmail.com
INIT_SUPER_ADMIN_PASSWORD=change-this-before-production
