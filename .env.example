# Copy this file to `.env` in the repo root before running `docker compose
# up` — that's the only file docker-compose.yml reads env vars from. Never
# commit the real `.env` (it's already in .gitignore).

NODE_ENV=production
PORT=5001

# Comma-separated list of allowed CORS origins. Required whenever
# NODE_ENV=production — server/src/app.ts throws on startup otherwise. With
# the default setup here (client's nginx reverse-proxies /api to the server
# on the same origin), this just needs to be wherever the client is actually
# reachable from a browser, e.g. http://your-vps-ip or https://your-domain.
CORS_ORIGIN=http://localhost

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- MongoDB ---
# Root credentials the `mongo` container initializes with (consumed via
# MONGO_INITDB_ROOT_USERNAME/PASSWORD/DATABASE in docker-compose.yml).
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-to-a-strong-password
MONGO_DATABASE=nirvana-cms

# Full connection string the server container uses. Must point at the
# `mongo` service by its Compose network hostname (not localhost), and stay
# in sync with the three vars above — authSource=admin because it
# authenticates as Mongo's root user. If you change the username, password,
# or database name above, update this to match.
MONGO_URI=mongodb://root:change-me-to-a-strong-password@mongo:27017/nirvana-cms?authSource=admin

# --- First-run SuperAdmin (see server/scripts/ensureSuperAdmin.ts) ---
# Consumed by
# `docker compose run --rm server-init npx tsx scripts/ensureSuperAdmin.ts`
# (see DOCKER.md). Only ever creates a user if no user with this email
# already exists — safe to leave set and re-run after every migration/deploy.
INIT_SUPER_ADMIN_EMAIL=mustapha.hamze1@gmail.com
INIT_SUPER_ADMIN_PASSWORD=change-this-before-production
