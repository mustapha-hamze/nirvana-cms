node_modules/
dist/
build/
.env
*.local
.DS_Store
npm-debug.log*
bun-debug.log*

# Uploaded files — keep directory structure via .gitkeep, ignore all
# generated content under server/storage (images/videos/documents, each
# split into contents|pages|applications subfolders).
server/storage/**
!server/storage/**/
!server/storage/**/.gitkeep

admin.crt.txt

# MongoDB dump/backup output (see MIGRATION.md) — contains real user/CMS
# data, never something to commit.
/mongo-dump/
/mongo-backup-*/
/storage-backup-*/

# Playwright e2e (see /e2e) — generated auth state and run artifacts.
/e2e/.auth/
/e2e/test-results/
/e2e/playwright-report/